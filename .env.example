# Copy this file to .env and fill in your own values.
# .env is git-ignored: never commit real credentials.

# MongoDB connection string (Atlas or local MongoDB).
# Used by the loaders, the stream store and the read-only API query layer.
MONGODB_URI=

# Database that holds player_wins, surface_analysis,
# tournament_analysis, stream_events and stream_metrics.
MONGODB_DATABASE=tennis_analytics

# API key for the live ATP match feed used by
# src/stream_mining/live_tennis_stream.py (optional).
LIVE_TENNIS_API_KEY=